# ============================================================
# bug-track 微服务框架 - 环境变量
# 复制为 .env 后生效（.env 已被 .gitignore 忽略）
# ============================================================

# ---------- bug-service ----------
# HTTP 服务监听端口
BUG_HTTP_PORT=3001
# gRPC 服务监听地址
BUG_GRPC_URL=0.0.0.0:5001

# ---------- file-service ----------
# HTTP 服务监听端口
FILE_HTTP_PORT=3002
# gRPC 服务监听地址
FILE_GRPC_URL=0.0.0.0:5002

# ---------- 跨服务调用地址 ----------
# bug-service 作为 gRPC 客户端去连接 file-service 的地址
FILE_SERVICE_GRPC_URL=localhost:5002

# ---------- 数据目录 ----------
# txt 持久化根目录，相对路径基于仓库根目录解析
# 目录结构：data/bugs/*.txt  data/files/*.txt  data/uploads/*
DATA_DIR=./data

# ---------- 文件上传 ----------
# 单个文件最大字节数（默认 10MB）
MAX_FILE_SIZE=10485760
# 跨服务 gRPC 调用超时（毫秒）
GRPC_TIMEOUT_MS=5000
